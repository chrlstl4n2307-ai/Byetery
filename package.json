{
  "name": "byetery-monorepo",
  "private": true,
  "scripts": {
    "demo": "npm --prefix backend run demo",
    "test:backend": "npm --prefix backend run verify",
    "test:python": "python -m unittest discover -s tools/python -p test_*.py -v",
    "verify": "pwsh -NoProfile -File scripts/verify.ps1",
    "api": "npm --prefix backend run api",
    "demo:api": "npm --prefix backend run demo:api",
    "test:http:dev": "npm --prefix backend run test:http:dev",
    "dev:setup": "npm --prefix backend run dev:setup --",
    "frontend": "npm --prefix frontend run dev",
    "verify:frontend": "npm --prefix frontend run verify",
    "demo:visual": "node --experimental-strip-types scripts/demo-visual.mts"
  }
}
