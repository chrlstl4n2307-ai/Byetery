# Non-sensitive examples only. The DEV connection checker reads the ignored root .env.
BYETERY_MODE=MOCK
BYETERY_DEPLOYMENT_ID=11111111-1111-4111-8111-111111111111
# Supabase Cloud DEV server credentials. Keep real values only in the ignored .env.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STELLAR_RPC_URL=
STELLAR_CONTRACT_ID=
STELLAR_SERVICE_SECRET=
STELLAR_ADMIN_SECRET=

# DEV connectivity checker (server-side only). Certificate is public; keep TLS verification enabled.
BYETERY_ENV=DEV
SUPABASE_PROJECT_REF=
DATABASE_SSL_CA=.tools/certificates/supabase-ca.crt

# Optional explicit server-only Testnet selection. Keep BYETERY_MODE=MOCK by default.
# Set BYETERY_MODE=TESTNET only for a reviewed application execution.
BYETERY_TESTNET_DEPLOYMENT_ID=
BYETERY_SIGNER_BINARY=
# Optional existing ignored server config file; relative certificate paths follow that file.
BYETERY_CONFIG_FILE=
# Fixed Testnet RPC/contract/actors and 50M signer cap are enforced by the adapter.
# This adapter uses Secure Store; it does not use STELLAR_*_SECRET values.
