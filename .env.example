# Non-sensitive examples only. The DEV connection checker reads the ignored root .env.
BYETERY_MODE=MOCK
BYETERY_DEPLOYMENT_ID=11111111-1111-4111-8111-111111111111
# Supabase Cloud DEV server credentials. Keep real values only in the ignored .env.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STELLAR_RPC_URL=
STELLAR_CONTRACT_ID=
STELLAR_SERVICE_SECRET=
STELLAR_ADMIN_SECRET=

# DEV connectivity checker (server-side only). Certificate is public; keep TLS verification enabled.
BYETERY_ENV=DEV
SUPABASE_PROJECT_REF=
DATABASE_SSL_CA=.tools/certificates/supabase-ca.crt
